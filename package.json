{
	"name": "spinverse-homework",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^6.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-devtools-svelte": "^0.11.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26",
		"@vitejs/devtools": "^0.8.3",
		"@vitejs/devtools-rolldown": "^0.8.3",
		"@vitejs/devtools-vite": "^0.8.3",
		"@vitejs/devtools-vitest": "^0.8.3",
		"daisyui": "^5.8.1",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8"
	},
	"dependencies": {
		"@openrouter/sdk": "^1.5.120",
		"@sqliteai/sqlite-vector": "^1.2.0",
		"@sqliteai/sqlite-vector-linux-x86_64": "^1.2.0",
		"better-sqlite3": "^13.2.0"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"esbuild@0.25.12": true,
		"esbuild@0.18.20": true,
		"better-sqlite3@13.2.0": true
	}
}
